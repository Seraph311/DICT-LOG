# Copy this file to .env at the repository root.

# --- Server ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Required. The server exits if this is missing. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Database ---
# Use EITHER DATABASE_URL (TCP) OR the local peer-auth socket settings below.
# 1) TCP connection:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dict_logsheet
# 2) Local peer-auth socket (no password, uses your OS user):
# DATABASE_SOCKET=/run/postgresql
# DATABASE_NAME=dict_logsheet
# DATABASE_USER=seraph

# --- Seed (development only) ---
# Quote values that contain # so it is not read as a comment.
SEED_DEMO_PASSWORD="Demo#2026"
